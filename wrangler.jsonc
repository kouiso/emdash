{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ai-eng-blog",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-10-25",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "emdash-trial-20261021-db",
			"database_id": "a4b9eeef-6a0e-4fb5-9261-bb58a4286214",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "emdash-trial-20261021-media",
		},
	],
	"workers_dev": true,
	"kv_namespaces": [
		{ "binding": "SESSION", "id": "12fbffdd4ec5416999785817007ee354" }
	],
	"observability": { "enabled": true, "head_sampling_rate": 1 },
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
