---
import "../styles/theme.css";
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { readEnv } from "../utils/env";
import { getSiteOrigin } from "../utils/site-origin";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

type PageContextInput = Parameters<typeof createPublicPageContext>[0];

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	/** 省略するとクエリを除いた今の URL を canonical にする */
	canonical?: string | null;
	/** 記事は "article" にする。EmDashHead が BlogPosting の JSON-LD と article:* を出す */
	pageType?: "website" | "article";
	articleMeta?: PageContextInput["articleMeta"];
	/** 404 など検索に出さないページ。canonical を出さず noindex にする */
	noindex?: boolean;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	pageType = "website",
	articleMeta,
	noindex = false,
	content,
} = Astro.props;
const [settingsResult, menuResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
}

const { siteTitle, siteTagline, siteLogo } = resolveStarterSiteIdentity(
	settingsResult.data,
);
const titleIncludesSiteName =
	title === siteTitle ||
	title.endsWith(` | ${siteTitle}`) ||
	title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;
const pageDescription = description ?? siteTagline;

// 管理画面でメニューが空のときも、デザインどおりの3項目を出す
const fallbackNav = [
	{ label: "入門ステップ講座", url: "/#course", target: undefined },
	{ label: "記事一覧", url: "/posts", target: undefined },
	{ label: "特典", url: "/#gift", target: undefined },
];
const navItems =
	menuResult.data && menuResult.data.items.length > 0
		? menuResult.data.items
		: fallbackNav;
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const siteOrigin = getSiteOrigin(Astro.url);
const pageCanonical = noindex
	? null
	: (canonical ?? new URL(currentPath, siteOrigin).href);
// 計測は Cloudflare Web Analytics（Cookie を使わない無料の計測）。トークンが無い環境では出さない
const analyticsToken = readEnv("PUBLIC_CF_ANALYTICS_TOKEN");

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical: pageCanonical,
	image,
	content,
	siteName: siteTitle,
	siteUrl: siteOrigin,
	articleMeta,
});
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		{noindex && <meta name="robots" content="noindex" />}
		<EmDashHead page={pageCtx} />
		{
			analyticsToken && (
				<script
					is:inline
					type="module"
					src="https://static.cloudflareinsights.com/beacon.min.js"
					data-cf-beacon={JSON.stringify({ token: analyticsToken })}
				/>
			)
		}
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<a class="skip-link" href="#main">本文へ移動</a>

		<header class="site-header">
			<div class="container site-header__inner">
				<a class="site-logo" href="/">
					{
						siteLogo ? (
							<img src={siteLogo.url} alt={siteLogo.alt || siteTitle} />
						) : (
							siteTitle
						)
					}
				</a>
				<nav class="site-nav" aria-label="メイン">
					{
						navItems.map((item) => (
							<a
								href={item.url}
								target={item.target}
								rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
								aria-current={item.url === currentPath ? "page" : undefined}
							>
								{item.label}
							</a>
						))
					}
				</nav>
			</div>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="site-footer">
			{siteTitle} ・ <a href="/privacy">プライバシーポリシー</a> ・ 記事は AI 支援で執筆しています
		</footer>

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
